# Lokale bron voor het namespacegebonden acceptatie-SealedSecret. Nooit committen als
# deploy/secrets-acceptance.env.
HKH_DATABASE_URL=jdbc:postgresql://database:5432/hkh
HKH_DATABASE_USER=hkh_acceptance
HKH_DATABASE_PASSWORD=hkh_acceptance_only
HKH_CORS_ALLOWED_ORIGIN_PATTERNS=
HKH_GOOGLE_CLIENT_ID=
HKH_ADMIN_ALLOWED_EMAILS=
HKH_PREVIEW_ENABLED=true
HKH_PREVIEW_MARKER=hkh-autopilot-acceptance

HKH_AGENT_RUNTIME_URL=https://agent-runtime-acceptance.vdzonsoftware.nl
HKH_AGENT_RUNTIME_TOKEN=replace-with-the-hkh-autopilot-consumer-token
HKH_AGENT_RUNTIME_PROJECT_PREFIX=HKH_AUTOPILOT
HKH_AGENT_RUNTIME_PROVIDER=MOCKED
HKH_AGENT_RUNTIME_MODEL=gpt-5.6-sol
HKH_AGENT_RUNTIME_EXECUTION_TIMEOUT_SECONDS=3600
