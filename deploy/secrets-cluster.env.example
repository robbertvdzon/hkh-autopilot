# Kopieer naar deploy/secrets-cluster.env; die file wordt door Git genegeerd.
# Kies voor clustergebruik een sterk, uniek wachtwoord.
HKH_DATABASE_URL=jdbc:postgresql://database:5432/hkh
HKH_DATABASE_USER=hkh
HKH_DATABASE_PASSWORD=replace-with-a-long-random-password

# Beide leeg laten schakelt Google-login veilig uit.
HKH_GOOGLE_CLIENT_ID=
HKH_ADMIN_ALLOWED_EMAILS=

# Komma-gescheiden browser-origins die de backend mogen benaderen.
HKH_CORS_ALLOWED_ORIGIN_PATTERNS=https://admin.example.com

# Eigen, minimaal bevoegde Agent Runtime-consument voor productie.
HKH_AGENT_RUNTIME_URL=https://agent-runtime.vdzonsoftware.nl
HKH_AGENT_RUNTIME_TOKEN=replace-with-the-hkh-autopilot-consumer-token
HKH_AGENT_RUNTIME_PROJECT_PREFIX=HKH_AUTOPILOT
HKH_AGENT_RUNTIME_PROVIDER=CODEX
HKH_AGENT_RUNTIME_MODEL=gpt-5.6-sol
HKH_AGENT_RUNTIME_EXECUTION_TIMEOUT_SECONDS=3600
