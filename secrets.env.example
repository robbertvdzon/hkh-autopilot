# Copy this file to ./secrets.env for local development.
# Never commit real production values. These defaults are only for docker-compose.dev.yml.
HKH_DATABASE_URL=jdbc:postgresql://localhost:5435/hkh
HKH_DATABASE_USER=hkh
HKH_DATABASE_PASSWORD=hkh

# Google Web OAuth client ID and comma-separated admin e-mail allowlist.
# The admin login remains disabled while these values are empty.
HKH_GOOGLE_CLIENT_ID=
HKH_ADMIN_ALLOWED_EMAILS=

# JWKS source for the record intake access token (RS256, issuer https://hkh-autopilot.local,
# audience hkh-autopilot-record-intake). Record intake stays disabled while this is empty.
HKH_RECORD_INTAKE_JWKS_URL=

# Base64-encoded AES-256 key used to encrypt an optional archieven.nl access token. Only relevant
# if the archive endpoint ever starts requiring one (it does not today); encryption fails closed
# while this is empty.
HKH_EXTERNAL_VERIFICATION_TOKEN_KEY=

# Base64-encoded AES-256 key used to encrypt temporarily retained personsearch job data (original
# query, validated source records, answer claims) until retention cleanup removes it. Encryption
# fails closed while this is empty.
HKH_PERSON_SEARCH_PAYLOAD_KEY=

# Duurzame AI-uitvoering via de gedeelde Agent Runtime. Het token is een eigen HKH Autopilot-
# consumentcredential en mag nooit worden gedeeld met Product Factory, Software Factory of HKH.
HKH_AGENT_RUNTIME_URL=https://agent-runtime.vdzonsoftware.nl
HKH_AGENT_RUNTIME_TOKEN=
HKH_AGENT_RUNTIME_PROJECT_PREFIX=HKH_AUTOPILOT
HKH_AGENT_RUNTIME_PROVIDER=CODEX
HKH_AGENT_RUNTIME_MODEL=gpt-5.6-sol
HKH_AGENT_RUNTIME_EXECUTION_TIMEOUT_SECONDS=3600
